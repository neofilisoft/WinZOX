// Windows resource file for the WinZOX CLI executable.
// Embeds the application icon and the VERSIONINFO block surfaced by
// File Explorer's Properties > Details panel.

#include <winver.h>

#ifndef WINZOX_VERSION_MAJOR
#  define WINZOX_VERSION_MAJOR 3
#endif
#ifndef WINZOX_VERSION_MINOR
#  define WINZOX_VERSION_MINOR 1
#endif
#ifndef WINZOX_VERSION_PATCH
#  define WINZOX_VERSION_PATCH 0
#endif
#ifndef WINZOX_VERSION_BUILD
#  define WINZOX_VERSION_BUILD 0
#endif
#ifndef WINZOX_VERSION_STRING
#  define WINZOX_VERSION_STRING "3.1.0"
#endif

// IDI_ICON1 = 1; Explorer takes the lowest-numbered RT_GROUP_ICON as the file's
// representative icon. Keep this stable across builds.
1 ICON "favicon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WINZOX_VERSION_MAJOR,WINZOX_VERSION_MINOR,WINZOX_VERSION_PATCH,WINZOX_VERSION_BUILD
PRODUCTVERSION WINZOX_VERSION_MAJOR,WINZOX_VERSION_MINOR,WINZOX_VERSION_PATCH,WINZOX_VERSION_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Neofilisoft"
            VALUE "FileDescription",  "WinZOX Archiver Console"
            VALUE "FileVersion",      WINZOX_VERSION_STRING
            VALUE "InternalName",     "zox"
            VALUE "LegalCopyright",   "Copyright (C) 2025 Neofilisoft"
            VALUE "OriginalFilename", "zox.exe"
            VALUE "ProductName",      "WinZOX Archiver"
            VALUE "ProductVersion",   WINZOX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
